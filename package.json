  },
  "dependencies": {
    "next": "16.2.12",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.185.1",
    "@react-three/fiber": "^9.6.1",
    "@react-three/drei": "^10.7.7",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
