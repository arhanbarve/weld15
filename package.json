{
  "name": "weld15",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D model of Weld 15, Harvard Yard",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
